# Which free provider to use — "groq" (default, higher free-tier limits) or "gemini"
AI_PROVIDER=groq

# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model (defaults to llama-3.3-70b-versatile, on the free tier)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — free key at https://aistudio.google.com/app/apikey
# (only needed if you set AI_PROVIDER=gemini above)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
